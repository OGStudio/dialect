#!/bin/bash -e
SDIR=$(cd "$(dirname "$0")" ; pwd -P)

SRC=$SDIR/../generator/ver-mac/src
OUT=$SDIR/../generator/generator-script.swift
VER=$(cat "$SDIR/../VERSION")

# Bundle every generator source into one runnable script, so it can be
# executed directly (swift generator/generator-script.swift) without an SPM build.
{
    echo "// Version $VER"
    echo "//"
    echo "// Part of the Dialect project:"
    echo "//    https://github.com/OGStudio/dialect"
    echo "//"
    echo "// GENERATED by util/package-generator-script - do not edit."
    echo

    # Engine + generated component/context code first.
    cat "$SRC/dialect.swift"

    # Component sources, grouped and ordered for a stable output.
    find -L "$SRC" -name '*.swift' \
        -not -path "$SRC/dialect.swift" \
        -not -path "$SRC/main.swift" \
        | sort \
        | while read -r f; do
            echo
            cat "$f"
        done

    # Entry point last: its top-level statements become the script's main.
    echo
    cat "$SRC/main.swift"
} > "$OUT"

echo "Wrote $OUT"
