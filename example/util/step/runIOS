#!/bin/bash -e

STEP=$((STEP+1))
echo -e "\n> > > > Step №$STEP. Run iOS simulator app"

DEV="${IOS_DEVICE:-iPhone 16}"
UDID=$(xcrun simctl list devices available | grep "$DEV" | head -1 | sed -E 's/.*\(([0-9A-F-]{36})\).*/\1/')

if [ -z "$UDID" ]; then
    echo "error: iOS simulator device '$DEV' not found (set IOS_DEVICE, see: xcrun simctl list devices available)" >&2
    exit 1
fi

echo "-> device: $DEV ($UDID)"
xcrun simctl bootstatus "$UDID" -b >/dev/null

xcrun simctl install "$UDID" "$APP_IOS"
xcrun simctl launch --console-pty "$UDID" com.example.HelloWorld